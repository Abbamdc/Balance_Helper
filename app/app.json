{
  "expo": {
    "name": "Balance Helper",
    "slug": "balance-helper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.balancehelper"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a"
      },
      "package": "ABTech.balancehelper",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiUrl": "https://balance-helper-server.onrender.com",
      "eas": {
        "projectId": "7bcc5574-ddb5-4607-9a8d-1d4906e26278"
      }
    }
  }
}
